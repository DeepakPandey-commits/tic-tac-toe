# WebSocket URL for the multiplayer server.
# Copy this file to .env.local for local development (Vite auto-loads it automatically).
# Only variables prefixed VITE_ are exposed to the frontend bundle — never put
# server secrets here.
#
# Local development:
VITE_WS_URL=ws://localhost:8080
#
# Production — point this at your deployed WebSocket server and use wss:// (TLS),
# not ws://, since browsers refuse insecure ws:// connections from an https:// page:
# VITE_WS_URL=wss://YOUR-WEBSOCKET-SERVER
